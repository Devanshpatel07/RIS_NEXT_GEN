# ==========================================
# RIS NextGen SMTP Server Configuration
# ==========================================

# Port the backend server will listen on
PORT=5000

# SMTP Provider Settings (Port 587 with STARTTLS prevents socket disconnections)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Your Admin Gmail & 16-character App Password (remove all spaces)
SMTP_USER=risnextgenpvtltd@gmail.com
SMTP_PASS=abcdefghijklmnop

# Where admin alerts will be delivered
ADMIN_EMAIL=risnextgenpvtltd@gmail.com
